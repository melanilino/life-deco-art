rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública: cualquiera puede ver el contenido del sitio
    // Escritura: solo usuarios autenticados (login del CMS)
    match /content/{pageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
