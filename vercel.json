{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.dc\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/NavBar.dc.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(support|image-slot)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(design-system|site-enhancements)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|avif|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(cms|firebase-config)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/cms",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Inicio.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Sobre Mi.dc.html",
      "destination": "/sobre-mi",
      "permanent": true
    },
    {
      "source": "/Tienda.dc.html",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/Aprende.dc.html",
      "destination": "/aprende",
      "permanent": true
    },
    {
      "source": "/Contacto.dc.html",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/Blog Post.dc.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/Politica de Privacidad.dc.html",
      "destination": "/politica-de-privacidad",
      "permanent": true
    },
    {
      "source": "/Terminos y Condiciones.dc.html",
      "destination": "/terminos-y-condiciones",
      "permanent": true
    },
    {
      "source": "/CMS.dc.html",
      "destination": "/cms",
      "permanent": true
    },
    {
      "source": "/Productos.dc.html",
      "destination": "/tienda/bandeja-te-elijo-hoy",
      "permanent": true
    },
    {
      "source": "/Aprende Detalle.dc.html",
      "destination": "/aprende/cursos/lettering-para-bodas",
      "permanent": true
    },
    {
      "source": "/Recursos.dc.html",
      "destination": "/aprende/gratis/plantilla-trazos-basicos",
      "permanent": true
    },
    {
      "source": "/Servicios.dc.html",
      "destination": "/servicios/rotulacion",
      "permanent": true
    },
    {
      "source": "/Encargos.dc.html",
      "destination": "/encargo-personalizado",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/Inicio.dc.html"
    },
    {
      "source": "/sobre-mi",
      "destination": "/Sobre Mi.dc.html"
    },
    {
      "source": "/tienda",
      "destination": "/Tienda.dc.html"
    },
    {
      "source": "/aprende",
      "destination": "/Aprende.dc.html"
    },
    {
      "source": "/contacto",
      "destination": "/Contacto.dc.html"
    },
    {
      "source": "/blog",
      "destination": "/Blog Post.dc.html"
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "/Politica de Privacidad.dc.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/Terminos y Condiciones.dc.html"
    },
    {
      "source": "/cms",
      "destination": "/CMS.dc.html"
    },
    {
      "source": "/tienda/bandeja-te-elijo-hoy",
      "destination": "/Productos.dc.html"
    },
    {
      "source": "/tienda/producto",
      "destination": "/Productos.dc.html"
    },
    {
      "source": "/aprende/cursos/lettering-para-bodas",
      "destination": "/Aprende Detalle.dc.html"
    },
    {
      "source": "/aprende/curso",
      "destination": "/Aprende Detalle.dc.html"
    },
    {
      "source": "/aprende/talleres/lettering-desde-cero",
      "destination": "/Aprende Detalle.dc.html"
    },
    {
      "source": "/aprende/taller",
      "destination": "/Aprende Detalle.dc.html"
    },
    {
      "source": "/aprende/gratis/plantilla-trazos-basicos",
      "destination": "/Recursos.dc.html"
    },
    {
      "source": "/aprende/recurso",
      "destination": "/Recursos.dc.html"
    },
    {
      "source": "/servicios/rotulacion",
      "destination": "/Servicios.dc.html"
    },
    {
      "source": "/servicios/personalizados",
      "destination": "/Servicios.dc.html"
    },
    {
      "source": "/servicios/packaging",
      "destination": "/Servicios.dc.html"
    },
    {
      "source": "/servicios/souvenirs",
      "destination": "/Servicios.dc.html"
    },
    {
      "source": "/encargo-personalizado",
      "destination": "/Encargos.dc.html"
    }
  ]
}
