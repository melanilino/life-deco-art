{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)\\.dc\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(support|image-slot)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(cms|firebase-config)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/cms",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Inicio.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Sobre Mi.dc.html",
      "destination": "/sobre-mi",
      "permanent": true
    },
    {
      "source": "/Tienda.dc.html",
      "destination": "/tienda",
      "permanent": true
    },
    {
      "source": "/Aprende.dc.html",
      "destination": "/aprende",
      "permanent": true
    },
    {
      "source": "/Contacto.dc.html",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/Blog Post.dc.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/Politica de Privacidad.dc.html",
      "destination": "/politica-de-privacidad",
      "permanent": true
    },
    {
      "source": "/Terminos y Condiciones.dc.html",
      "destination": "/terminos-y-condiciones",
      "permanent": true
    },
    {
      "source": "/CMS.dc.html",
      "destination": "/cms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/Inicio.dc.html"
    },
    {
      "source": "/sobre-mi",
      "destination": "/Sobre Mi.dc.html"
    },
    {
      "source": "/tienda",
      "destination": "/Tienda.dc.html"
    },
    {
      "source": "/aprende",
      "destination": "/Aprende.dc.html"
    },
    {
      "source": "/contacto",
      "destination": "/Contacto.dc.html"
    },
    {
      "source": "/blog",
      "destination": "/Blog Post.dc.html"
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "/Politica de Privacidad.dc.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/Terminos y Condiciones.dc.html"
    },
    {
      "source": "/cms",
      "destination": "/CMS.dc.html"
    }
  ]
}
